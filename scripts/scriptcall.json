# Create a JSON file with the base64 data
base64 -i doctor_patient_conversation.wav | awk '{printf "\"audio_data\": \"%s\",\n", $0}' > audio_data.txt

# Then create the full JSON file
echo '{' > request.json
cat audio_data.txt >> request.json
echo '"file_name": "doctor_patient_conversation.wav"' >> request.json
echo '}' >> request.json

# Now send the request from the file
curl -X POST http://localhost:8000/process-audio \
  -H "Content-Type: application/json" \
  -d "@request.json"